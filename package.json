{
  "name": "jarvis",
  "version": "0.1.0",
  "private": true,
  "description": "JARVIS — personal AI chief of staff. V1: MESA LMS monitoring.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "mesa:login": "npm run -w @jarvis/worker mesa:login",
    "mesa:extract": "npm run -w @jarvis/worker mesa:extract",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run lint && npm test",
    "setup:db": "npm run -s -w @jarvis/worker setup:db",
    "db:migrate": "npm run -s -w @jarvis/worker db:migrate",
    "sync:mesa": "npm run -s -w @jarvis/worker sync:mesa --",
    "edge:build": "esbuild supabase/functions/mesa-sync/entry.ts --bundle --format=esm --platform=neutral --target=es2022 --main-fields=module,main --conditions=import --alias:postgres=npm:postgres@3.4.9 --external:npm:* --external:node:* --legal-comments=none --outfile=supabase/functions/mesa-sync/index.js",
    "deploy:cloud": "npm run -s -w @jarvis/worker deploy:cloud"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "playwright-core": "^1.63.0",
    "postgres": "^3.4.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
