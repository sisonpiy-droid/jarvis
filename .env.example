# Copy to .env (gitignored). Never commit real values.

# 32-byte key (base64) that encrypts the saved MESA browser session at rest.
# `npm run mesa:login` generates one into .env if this is unset.
MESA_SESSION_KEY=

# Browser Playwright drives for interactive login: msedge | chrome | chromium
# (chromium needs `npx playwright install chromium`).
MESA_BROWSER_CHANNEL=msedge

# Politeness limits for the LMS API.
MESA_MAX_CONCURRENCY=3
MESA_MIN_GAP_MS=150
# Optional: override the MESA job's pg_cron schedule (default */5 * * * *).
MESA_SYNC_CRON=

# --- Supabase (Postgres + Storage). Server/worker only — never the browser. ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=
# Session-pooler URI; `npm run setup:db` writes this for you (handles encoding).
SUPABASE_DB_URL=
# Optional: pooler host used by `npm run setup:db` (default aws-0-ap-south-1.pooler.supabase.com).
SUPABASE_DB_HOST=
# Personal access token for the Supabase CLI (`npm run deploy:cloud`).
SUPABASE_ACCESS_TOKEN=
# (Edge Functions also get SUPABASE_DB_URL, SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY from the platform.)

# Shared secret: pg_cron → Edge Functions, Edge → dashboard jobs.
CRON_SECRET=

# --- Notifications (the in-app inbox needs none of these) ---
# Web Push signing keys: `npm run setup:push` creates them once. Never change them after phones subscribe.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Optional contact for push services (mailto: or https:); defaults to NOTIFY_EMAIL_TO.
VAPID_SUBJECT=
# Email via Resend (resend.com, free): API key + your address (the Resend account's email, unless a domain is verified).
RESEND_API_KEY=
NOTIFY_EMAIL_TO=
# Optional sender, e.g. "JARVIS <jarvis@your-domain>" once a domain is verified (default: onboarding@resend.dev).
NOTIFY_EMAIL_FROM=

# --- Telegram (legacy channel; optional since Phase 1, removed in Phase 11) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# --- AI (aistudio.google.com/apikey) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Optional: a different model for assignment deliverables (defaults to GEMINI_MODEL).
GEMINI_DRAFT_MODEL=
# Optional: set to "off" to stop drafting the assignment backlog automatically.
AUTO_DRAFT=
# Optional: set to "off" to write the morning brief's focus note without AI (the fixed-template note instead).
BRIEF_AI=

# --- Dashboard ---
WEB_SESSION_SECRET=
# Public origin of the dashboard (login links point here). Vercel sets VERCEL_PROJECT_PRODUCTION_URL automatically.
WEB_BASE_URL=
# Public URL of the dashboard; the cloud jobs and bot send drafting jobs here
JARVIS_WEB_URL=

# Optional: Google Calendar 'Secret address in iCal format' (personal account)
GCAL_ICS_URL=

# Optional: set to 1 for debug-level logs.
JARVIS_DEBUG=
